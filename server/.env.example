# Copiá este archivo como server/.env y completá las contraseñas.
# server/.env NO se sube a GitHub (está en .gitignore).

PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Solo se usa en "npm run db:setup" para crear usuarios y bases.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=tu_password_de_root

# Usuarios que crea el setup (inventá contraseñas largas; no son las de root).
APP_DB_USER=sqlp_app
APP_DB_PASSWORD=cambiar_app_123
APP_DB_NAME=sqlpractica_app
READER_DB_USER=sqlp_reader
READER_DB_PASSWORD=cambiar_reader_123
SANDBOX_DB_USER=sqlp_sandbox
SANDBOX_DB_PASSWORD=cambiar_sandbox_123

# Límites de ejecución
QUERY_TIMEOUT_MS=5000
MAX_ROWS=5000
DISPLAY_ROWS=500
